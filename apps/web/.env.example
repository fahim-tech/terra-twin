# Base URL of the TerraTwin FastAPI service (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000
# Optional Cesium ion token. When set, the Mars globe uses the official Cesium Mars 3D Tiles
# (asset 3644333) and Earth uses Cesium World Terrain. Without it, NASA Trek / GIBS imagery is used.
VITE_CESIUM_ION_TOKEN=
